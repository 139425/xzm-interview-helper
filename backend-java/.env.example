# Spring Boot configuration must be supplied by the deployment environment.
# Do not commit a populated .env file; rotate credentials that were previously stored in source.
JWT_SECRET=replace-with-a-random-32-plus-character-secret
DB_URL=jdbc:mysql://127.0.0.1:3306/helper
DB_USERNAME=replace-with-db-user
DB_PASSWORD=replace-with-db-password
INTERVIEW_SCHEMA_VALIDATION_ENABLED=true
LONGCAT_API_KEY=replace-with-provider-key
TENCENT_CLOUD_SECRET_ID=replace-with-secret-id
TENCENT_CLOUD_SECRET_KEY=replace-with-secret-key
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated literal IPs only. Leave blank when clients connect directly.
TRUSTED_PROXY_ADDRESSES=
PISTON_API_URL=http://127.0.0.1:2000/api/v2/execute
PISTON_API_TOKEN=
# Recruitment directory (optional overrides; defaults already satisfy daily refresh).
RECRUITMENT_GRADUATE_YEAR=0
RECRUITMENT_PLAYOFFER_PAGES=20
RECRUITMENT_MINIMUM_REFRESH_HOURS=20
RECRUITMENT_CHECK_INTERVAL_MS=3600000
RECRUITMENT_STALE_AFTER_DAYS=60
