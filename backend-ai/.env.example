# BigModel / Zhipu API Configuration
BIGMODEL_API_KEY=your_api_key_here
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
BIGMODEL_MODEL_NAME=glm-4.7-flashx

# DeepSeek API Configuration. Keep the real key only in an ignored .env,
# a secret manager, or deepseek.local.json; never commit it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Interview-agent model defaults. Individual RunInterviewAgent calls can
# override these values. The agent never returns raw model reasoning.
INTERVIEW_AGENT_PROVIDER=deepseek
INTERVIEW_AGENT_MODEL_NAME=deepseek-v4-pro
INTERVIEW_AGENT_ENABLE_THINKING=false
# Keep request-supplied provider/model/thinking disabled unless an operator
# deliberately permits a reviewed catalog for an experiment.
INTERVIEW_AGENT_ALLOW_REQUEST_MODEL_OVERRIDE=true
INTERVIEW_AGENT_ALLOWED_PROVIDERS=deepseek
INTERVIEW_AGENT_ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-pro
INTERVIEW_AGENT_ALLOW_REQUEST_THINKING_OVERRIDE=true

# RAG knowledge retrieval. Semantic embeddings are preferred when this key is
# configured; persisted/local Markdown and text chunks remain searchable via
# the dependency-free lexical fallback when the provider is unavailable.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# bge-large-zh-v1.5 supports 512 tokens. Keep a 32-token safety margin so
# chunk headers and tokenizer-estimation error do not exceed the provider cap.
EMBED_MAX_TOKENS=480
# Only enable for models that support configurable output dimensions, such as
# Qwen/Qwen3-Embedding. Changing model or dimensions requires a new collection.
# EMBEDDING_DIMENSIONS=1024
EMBED_TIMEOUT_SECONDS=20
EMBED_MAX_RETRIES=2
DOCS_DIR=docs
CHROMA_PERSIST_DIR=chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_COLLECTION_NAME=docs_v2
RAG_DENSE_CANDIDATES=30
RAG_LEXICAL_CANDIDATES=30
RAG_FUSION_CANDIDATES=40
RAG_MIN_RERANK_SCORE=0.08
RAG_MIN_QUERY_COVERAGE=0.25
RAG_MAX_CHUNKS_PER_PARENT=2
RAG_CHUNK_TARGET_TOKENS=280
RAG_CHUNK_MAX_TOKENS=360
RAG_CHUNK_OVERLAP_TOKENS=60
EMBED_BATCH_SIZE=64
EMBED_MAX_CHARS_PER_BATCH=200000

# Server Configuration
PORT=9090
HOST=127.0.0.1
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
